for regione in regioni_disponibili:
    # Filtriamo il subset di dati per la regione corrente del ciclo
    df_regione = df_2025[df_2025['Region'] == 'Africa Occidentale'] if regione == 'Africa Occidentale' else df_2025[df_2025['Region'] == regione]

    # Costruiamo il grafico specifico per questa regione
    chart_regione = alt.Chart(df_regione).mark_bar().encode(
        x=alt.X('mean(Percentage):Q', title='Media delle Percentuali', stack='zero', axis=alt.Axis(format='%')),
        y=alt.Y('Country:N', title='Paese', sort='-x'), # Ora mostra SOLO i paesi di questa regione!
        color=alt.Color('Phase:N', title='Fase (Phase)', scale=alt.Scale(scheme='yelloworangered'), sort=fasi_valide),
        tooltip=[
            alt.Tooltip('Country:N', title='Paese'),
            alt.Tooltip('Phase:N', title='Fase'),
            alt.Tooltip('mean(Percentage):Q', title='Media Percentuale', format='.1%')
        ]
    ).properties(
        width=600,
        height=alt.Step(25), # L'altezza si adatta automaticamente al numero di paesi presenti nella regione
        title=f"Regione: {regione} (Anno 2025)"
    ).transform_filter(
        alt.datum.Percentage >= filtro_interattivo
    ).add_params(
        filtro_interattivo
    )

    # Visualizziamo il grafico della regione corrente
    chart_regione.display()

----

# 1. DIZIONARIO DI MAPPATURA (Invariato)
mappa_regioni = {
    'LBN': 'Medio Oriente', 'PSE': 'Medio Oriente', 'YEM': 'Medio Oriente',
    'MRT': 'Nord Africa', 'SDN': 'Nord Africa',
    'BEN': 'Africa Occidentale', 'BFA': 'Africa Occidentale', 'CIV': 'Africa Occidentale',
    'GHA': 'Africa Occidentale', 'GIN': 'Africa Occidentale', 'GMB': 'Africa Occidentale',
    'GNB': 'Africa Occidentale', 'MLI': 'Africa Occidentale', 'NER': 'Africa Occidentale',
    'NGA': 'Africa Occidentale', 'SEN': 'Africa Occidentale', 'SLE': 'Africa Occidentale',
    'TGO': 'Africa Occidentale', 'CPV': 'Africa Occidentale',
    'BDI': 'Africa Orientale', 'DJI': 'Africa Orientale', 'ETH': 'Africa Orientale',
    'KEN': 'Africa Orientale', 'SOM': 'Africa Orientale', 'SSD': 'Africa Orientale',
    'TZA': 'Africa Orientale', 'UGA': 'Africa Orientale',
    'CAF': 'Africa Centrale', 'CMR': 'Africa Centrale', 'COD': 'Africa Centrale', 'TCD': 'Africa Centrale',
    'AGO': 'Africa Meridionale', 'LSO': 'Africa Meridionale', 'MDG': 'Africa Meridionale',
    'MOZ': 'Africa Meridionale', 'MWI': 'Africa Meridionale', 'NAM': 'Africa Meridionale',
    'SWZ': 'Africa Meridionale', 'ZAF': 'Africa Meridionale', 'ZMB': 'Africa Meridionale', 'ZWE': 'Africa Meridionale',
    'AFG': 'Asia Meridionale/Centrale', 'BGD': 'Asia Meridionale/Centrale', 'PAK': 'Asia Meridionale/Centrale',
    'TLS': 'Asia del Sud-Est',
    'DOM': 'America Latina e Caraibi', 'ECU': 'America Latina e Caraibi',
    'GTM': 'America Latina e Caraibi', 'HND': 'America Latina e Caraibi', 'HTI': 'America Latina e Caraibi', 'SLV': 'America Latina e Caraibi'
}

# 2. FILTRO TEMPORALE E PULIZIA
df_2['Date_From_Cleaned'] = pd.to_datetime(df_2['From'], errors='coerce')
df_2025 = df_2[df_2['Date_From_Cleaned'].dt.year == 2025].copy()
df_2025['Region'] = df_2025['Country'].map(mappa_regioni).fillna('Altro')

# Escludiamo rigorosamente 'all' e '3+' dal conteggio
fasi_valide = ['1', '2', '3', '4', '5']
df_2025 = df_2025[df_2025['Phase'].astype(str).isin(fasi_valide)]
df_2025 = df_2025.dropna(subset=['Country', 'Phase', 'Percentage', 'Number'])

# 💡 3. DISCRETIZZAZIONE E AGGREGAZIONE MATEMATICA IN PANDAS
def raggruppa_fasi(fase):
    fase_str = str(fase)
    if fase_str in ['1', '2']:
        return 'Fase 1-2: Stabile / Stress'
    elif fase_str in ['3', '4']:
        return 'Fase 3-4: Crisi / Emergenza'
    elif fase_str == '5':
        return 'Fase 5: Catastrofe / Carestia'
    return 'Altro'

df_2025['Phase_Grouped'] = df_2025['Phase'].apply(raggruppa_fasi)

# Raggruppiamo i PERSONE (Number) per Paese e per la nuova Macro-Fase
df_aggregato = df_2025.groupby(['Region', 'Country', 'Phase_Grouped'], as_index=False)['Number'].sum()

# Calcoliamo il totale della popolazione analizzata per ciascun Paese nel 2025
df_totale_paese = df_2025.groupby('Country')['Number'].sum().reset_index().rename(columns={'Number': 'Total_Analyzed_Pop'})

# Uniamo i dataset per fare la divisione corretta
df_finale = pd.merge(df_aggregato, df_totale_paese, on='Country')
df_finale['Percentage_Correct'] = df_finale['Number'] / df_finale['Total_Analyzed_Pop']

# Configurazione ordine e colori della legenda
ordine_gruppi = ['Fase 1-2: Stabile / Stress', 'Fase 3-4: Crisi / Emergenza', 'Fase 5: Catastrofe / Carestia']
colori_gruppi = ['#e0f3db', '#f4a582', '#b2182b']

alt.data_transformers.disable_max_rows()

# 4. CREAZIONE DEL PARAMETRO SLIDER GLOBALE (Filtra sulla percentuale calcolata)
slider_percentuale = alt.binding_range(
    min=0.0,
    max=1.0,
    step=0.05,
    name='Percentuale Minima Macro-Fase (0.0 - 1.0): '
)
filtro_interattivo = alt.param(
    name='Percentuale_Selezionata',
    value=0.0,
    bind=slider_percentuale
)

# 5. CICLO FOR PER GENERARE I GRAFICI REGIONALI PULITI
regioni_disponibili = sorted(df_finale['Region'].unique())

for region in regioni_disponibili:
    df_regione = df_finale[df_finale['Region'] == region]

    chart_regione = alt.Chart(df_regione).mark_bar().encode(
        # Usiamo la nuova percentuale pre-calcolata. Usiamo 'sum' ma ora la somma farà massimo 1.0 (100%)
        x=alt.X('sum(Percentage_Correct):Q', title='Percentuale Totale Paese', stack='zero', axis=alt.Axis(format='%')),
        y=alt.Y('Country:N', title='Paese', sort='-x'),
        color=alt.Color(
            'Phase_Grouped:N',
            title='Macro-Fasi Accorpate',
            scale=alt.Scale(domain=ordine_gruppi, range=colori_gruppi),
            sort=ordine_gruppi
        ),
        tooltip=[
            alt.Tooltip('Country:N', title='Paese'),
            alt.Tooltip('Phase_Grouped:N', title='Gruppo Fasi'),
            alt.Tooltip('Percentage_Correct:Q', title='Percentuale Reale', format='.1%'),
            alt.Tooltip('Number:Q', title='Persone colpite', format=',')
        ]
    ).properties(
        width=600,
        height=alt.Step(25),
        title=f"Regione: {region} (Anno 2025 - Valori Normalizzati)"
    ).transform_filter(
        alt.datum.Percentage_Correct >= filtro_interattivo
    ).add_params(
        filtro_interattivo
    )

    chart_regione.display()


