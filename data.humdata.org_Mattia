# 1. FILTRO TEMPORALE IN PANDAS (Solo anno 2025)
df_2['Date_From_Cleaned'] = pd.to_datetime(df_2['From'], errors='coerce')
df_2025 = df_2[df_2['Date_From_Cleaned'].dt.year == 2025].copy()

# Escludiamo le fasi cumulative ('all', '3+') per non duplicare i dati visivi
fasi_valide = ['1', '2', '3', '4', '5']
df_2025 = df_2025[df_2025['Phase'].astype(str).isin(fasi_valide)]

# Puliamo i dati mancanti dalle colonne che useremo
df_2025 = df_2025.dropna(subset=['Country', 'Phase', 'Percentage'])

# Disattiviamo il limite di righe di sicurezza di Altair
alt.data_transformers.disable_max_rows()


# 2. CREAZIONE DELLO SLIDER SULLA TUA COLONNA PERCENTAGE (0.0 - 1.0)
slider_percentuale = alt.binding_range(
    min=0.0,
    max=1.0,
    step=0.05,
    name='Percentuale Minima (es. 0.20 = 20%): '
)

filtro_interattivo = alt.param(
    name='Percentuale_Selezionata',
    value=0.0,
    bind=slider_percentuale
)


# 3. COSTRUZIONE DEL GRAFICO CON LIVELLO PAESE E MEDIA DELLE PERCENTUALI
grafico = alt.Chart(df_2025).mark_bar().encode(
    # Usiamo 'mean(Percentage)' per aggregare correttamente a livello Paese
    x=alt.X(
        'mean(Percentage):Q',
        title='Media delle Percentuali (dal Dataset)',
        stack='zero',
        axis=alt.Axis(format='%') # Mostra i decimali come 0.30 in formato 30%
    ),
    # Asse Y solo con il Paese
    y=alt.Y('Country:N', title='Paese (Country)', sort='-x'),
    color=alt.Color(
        'Phase:N',
        title='Fase (Phase)',
        scale=alt.Scale(scheme='yelloworangered'),
        sort=fasi_valide
    ),
    tooltip=[
        alt.Tooltip('Country:N', title='Paese'),
        alt.Tooltip('Phase:N', title='Fase'),
        alt.Tooltip('mean(Percentage):Q', title='Media Percentuale', format='.1%'),
        alt.Tooltip('mean(Total country population):Q', title='Popolazione Paese', format=',')
    ]
).properties(
    width=800,
    height=600,
    title="Distribuzione Media delle Fasi per Paese nel 2025 (Valori Originali)"
).transform_filter(
    # Il filtro interattivo agisce direttamente sulla tua colonna 'Percentage' prima dell'aggregazione
    alt.datum.Percentage >= filtro_interattivo
).add_params(
    filtro_interattivo
)

# Mostra il grafico
grafico

